# 复制为 .env 后填入：cp .env.example .env
# .env 已在 .gitignore 中，不会被提交。

# ───────── 管理令牌（写操作必需）─────────
# 解析 / 校准 / 删除 三个写接口需要请求头 X-Admin-Token。
# 不设置时这些接口会直接返回 503（fail closed）——这是刻意的：
# 宁可写操作不可用，也不能让公网上的任何人删你的库。
# 生成随机令牌：openssl rand -hex 24
ADMIN_TOKEN=

# ───────── 数据库位置（可选）─────────
# 默认 prototype/data/careersafari.db；容器部署时指向挂载卷。
# CAREERSAFARI_DB=/app/data/careersafari.db

# ───────── 开发环境逃生开关（公网部署切勿开启）─────────
# 某些本地开发环境（带透明代理的沙箱）会把域名解析到保留网段，
# 导致 SSRF 公网校验全数误杀。设为 1 可跳过「域名的公网地址」校验；
# 字面量内网 IP（如 169.254.169.254）仍然会被拦截。
# FETCH_ALLOW_NON_PUBLIC=1

# ───────── LLM 抽取后端 ─────────
# LLM_PROVIDER：mock | openai | anthropic | qwen（默认 mock，无需 key）
# LLM_PROVIDER=mock

# OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Anthropic
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# 通义千问（DashScope，OpenAI 兼容协议）
# LLM_PROVIDER=qwen
# QWEN_API_KEY=sk-...
# QWEN_MODEL=qwen-plus
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
